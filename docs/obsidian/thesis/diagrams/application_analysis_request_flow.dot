digraph application_analysis_request_flow {
  rankdir=TB;
  graph [fontname="Arial", fontsize=10, dpi=300, ranksep=0.35, nodesep=0.25, size="6,8!"];
  node [shape=box, fontname="Arial", fontsize=9, style=rounded, width=2.2, height=0.55];
  edge [fontname="Arial", fontsize=8];

  start [shape=ellipse, label="Начало"];
  ui [label="Интерфейс системы Reqcore,\nгде рекрутер открывает заявку\nкандидата и отправляет запрос\nна анализ этой заявки"];
  api [label="/api/applications/:id/analyze"];
  decision [shape=diamond, label="provider == biencoder?"];
  bi_call [label="Вызов адреса из BIENCODER_URL\nи маршрута /score"];
  bi_server [label="experiments/scripts/11_api_server.py"];
  bi_score [label="ATSRanker рассчитывает\nкосинусное сходство"];
  bi_save [label="Запись значения application.score"];
  llm_call [label="Вызов scoreApplication()"];
  llm_provider [label="provider.ts обращается\nк внешнему API большой\nязыковой модели"];
  llm_save [label="Получение criterion_score\nи application.score"];
  stop [shape=ellipse, label="Конец"];

  start -> ui -> api -> decision;
  decision -> bi_call [label="да"];
  decision -> llm_call [label="нет"];
  bi_call -> bi_server -> bi_score -> bi_save -> stop;
  llm_call -> llm_provider -> llm_save -> stop;
}
